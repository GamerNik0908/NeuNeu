# Kopiere diese Datei nach ".env" und entferne das "#" vor den Zeilen, die du nutzen willst.

# --- Server ---
PORT=3000
# Öffentliche Adresse (für Links in E-Mails und Stripe-Weiterleitungen)
APP_URL=http://localhost:3000
# Auf dem echten Server: NODE_ENV=production (aktiviert sichere Cookies & HSTS)
# NODE_ENV=production

# --- Zahlungen mit Stripe ---
# Ohne STRIPE_SECRET_KEY läuft Fakturo im Testbetrieb: Upgrades werden ohne Zahlung aktiviert.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO_MONTHLY=price_xxx
# STRIPE_PRICE_PRO_YEARLY=price_xxx
# STRIPE_PRICE_BUSINESS_MONTHLY=price_xxx
# STRIPE_PRICE_BUSINESS_YEARLY=price_xxx
# Kostenlose Testphase für neue Abonnenten in Tagen (0 = keine)
TRIAL_DAYS=14

# --- E-Mail-Versand (SMTP) ---
# Ohne SMTP versenden Nutzer Rechnungen über ihr eigenes E-Mail-Programm (PDF-Download + mailto).
# Geeignet sind z. B. Brevo, Postmark, Mailjet, Amazon SES oder dein Webhoster (Strato, IONOS, all-inkl).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=deine-login@beispiel.de
# SMTP_PASS=dein-smtp-passwort
# Absender – muss zu einer bei deinem Anbieter verifizierten Domain gehören:
# MAIL_FROM=Fakturo <rechnungen@deine-domain.de>

# --- Datenbank ---
# Standard: data/fakturo.db (tägliche Backups in data/backups/)
# DB_FILE=/pfad/zu/fakturo.db
